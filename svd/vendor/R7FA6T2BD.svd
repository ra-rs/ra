                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Disable synchronous counter clear by other channel other than the section of trough in complementary PWM mode</description>
                                    <value>#1</value>

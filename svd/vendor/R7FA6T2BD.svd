                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The internal reference clock divided by 2 (IICφ/2) is selected as the clock source of the SDA output delay counter.</description>
                                    <value>#1</value>

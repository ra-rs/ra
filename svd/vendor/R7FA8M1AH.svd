                            <msb>7</msb>
                            <access>read-write</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0000</name>
                                    <description>OCOCLK</description>
                                    <value>#0000</value>
                                </enumeratedValue>

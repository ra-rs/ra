                    <resetMask>0x007F</resetMask>
                    <fields>
                        <field>
                            <name>USBADDR</name>
                            <description>USB AddressWhen the function controller function is selected, these bits indicate the USB address assigned by the host.</description>
                            <lsb>0</lsb>
                            <msb>6</msb>
                            <access>read-write</access>
                        </field>
                        <field>
                            <name>Reserved</name>

                            <name>AF</name>
                            <description>Alarm flag</description>
                            <lsb>0</lsb>
                            <msb>0</msb>
                        </field>
                        <field>
                            <name>CF</name>
                            <description>Carry flag</description>
                            <lsb>1</lsb>
                            <msb>1</msb>
                        </field>
                        <field>
                            <name>PF</name>
                            <description>Interrupt period</description>
                            <lsb>2</lsb>
                            <msb>2</msb>
                        </field>
                        <field>
                            <name>Reserved</name>

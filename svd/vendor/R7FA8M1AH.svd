                                    <name>0x01</name>
                                    <description>Vendor Test Mode</description>
                                    <value>0x01</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name />
                                    <description>This value indicates that I3C Devices shall return a random 32bit value in the Provisional ID during the Dynamic Address Assignment procedure.</description>

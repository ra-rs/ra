                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>The calendar count mode.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>The binary count mode.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>

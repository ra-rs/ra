                            <msb>1</msb>
                            <access>read-only</access>
                            <enumeratedValues>
                                <enumeratedValue>
                                    <name>0</name>
                                    <description>An error has not occurs in the command index of the response to a command issued within a command sequence.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>

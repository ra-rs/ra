                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Generates "intflerr" interrupt request when CFAE = "1".</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>
                        </field>

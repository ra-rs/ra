                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>TZFOAD register writing is protected. Read is possible.</description>
                                    <value>#1</value>
                                </enumeratedValue>

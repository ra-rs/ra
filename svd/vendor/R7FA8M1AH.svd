                                    <description>Stops the temperature sensor.</description>
                                    <value>#0</value>
                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Starts the temperature sensor.</description>
                                    <value>#1</value>
                                </enumeratedValue>

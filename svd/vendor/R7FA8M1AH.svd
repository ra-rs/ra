                        <field>
                            <name>IPG</name>
                            <description>Interpacket Gap  Range from 16bit time(0x00) to 140bit time(0x1F) </description>
                            <lsb>0</lsb>
                            <msb>4</msb>
                            <access>read-write</access>
                            <enumeratedValues>

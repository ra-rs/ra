                                </enumeratedValue>
                                <enumeratedValue>
                                    <name>1</name>
                                    <description>Sampling by channel-dedicated sample-and-hold circuit is enable.</description>
                                    <value>#1</value>
                                </enumeratedValue>
                            </enumeratedValues>

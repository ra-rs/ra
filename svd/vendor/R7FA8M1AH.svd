                    <access>read-write</access>
                    <resetValue>0x0006</resetValue>
                    <resetMask>0xFFFF</resetMask>
                    <fields>
                        <field>
                            <name>TLPX</name>
                            <description>D-PHY T_TLPX Parameter Setting</description>

                    <resetMask>0xFFFF</resetMask>
                    <fields>
                        <field>
                            <name>ADBUF</name>
                            <description>A/D data buffer registers (ADBUF) are 16-bit read-only registers that sequentially store all A/D converted values. The automatic clear function is not applied to these registers.</description>
                            <lsb>0</lsb>
                            <msb>15</msb>
                            <access>read-only</access>
                        </field>
                    </fields>
                </register>
